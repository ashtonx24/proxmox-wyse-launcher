# Copy this file to /etc/proxmox-launcher/config.env and edit it.
# Keep this file readable only by root and the kiosk user.
PVE_HOST='192.168.2.2'
PVE_NODE='node-name'
PVE_VMID='102'
PVE_TOKEN_ID='launcher@pam!wyse-01'
PVE_TOKEN_SECRET='replace-me'

# Set to 0 only if the Proxmox API certificate is not trusted on the Wyse.
# Prefer installing the Proxmox CA instead of disabling verification.
PVE_TLS_VERIFY='1'

# Optional timing values, in seconds.
RETRY_SECONDS='5'
API_CONNECT_TIMEOUT='5'
API_TIMEOUT='15'
